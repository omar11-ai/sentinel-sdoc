# Copy to .env (or set in your host's dashboard). Never commit real keys.
SENTINEL_DATA=./mock_data
SENTINEL_MODE=folder
SENTINEL_USE_LLM=auto
# Get a FREE key: https://aistudio.google.com/apikey
# Free tier: ~10 requests/min, daily quota resets ~15:00 MYT (midnight PT).
# New-format Google keys ("AQ.…" ) authenticate via x-goog-api-key — handled.
SENTINEL_LLM_PROVIDER=gemini
SENTINEL_LLM_KEY=
SENTINEL_LLM_MODEL=gemini-flash-latest
SENTINEL_LLM_FAST_MODEL=gemini-3.1-flash-lite
# Batch runs use the deterministic engine by default (fast + zero quota);
# the interactive generalize/self-check paths are always AI-first when a key is set.
SENTINEL_LLM_BATCH=0
SENTINEL_ADVERSARIAL_MODE=advisory
SENTINEL_SCORING_URL=
